row = int(input("한 행에 출력할 구구단의 개수를 입력하세요: "))
stage = int(input("최대 출력할 단 수를 입력하세요: "))

#구구단 행 나누기
if stage%row ==0:
    n = stage//row
else:
    n = stage//row + 1

for k in range(0, n):   
    for i in range(1,10):
        end = row*(k+1) +1
        start = row*k+1

        for j in range(start, end):
            if j > stage:
                break
            print("{} x {} = {}".format(j, i, j*i), end="\t")
        print("")
    print("")